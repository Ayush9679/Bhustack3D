# Bhustack3D Environment Configuration Template
# ---------------------------------------------
# Set VITE_API_BASE_URL to one of:
# 1. Empty (default): Routes API requests through Vite's built-in reverse proxy (/auth -> localhost:8000).
#    Works seamlessly across localhost, mobile devices, and single-tunnel ngrok URLs.
# 2. http://localhost:8000 (direct local backend connection)
# 3. https://<your-backend-tunnel>.ngrok-free.dev (if running a dedicated second ngrok tunnel for FastAPI)
VITE_API_BASE_URL=
